#!/bin/bash
# backup_system.sh

#configuration
BACKUP_DIR="/backup/$(date +%Y%m%d_%H%M%S)"
SOURCE_DIRS="/etc/home/var/www"
LOG_FILE="/var/log/backup.log"
RETENTION_DAYS=7

#create backup directory
mkdir -p "$BACKUP_DIR"

#logging function
log() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" | tee -a "$LOG_FILE"
}

log "Backup Started"

#create compressed archive
tar -czf "$BACKUP_DIR/system_backup.tar.gz" $SOURCE_DIRS 2>/dev/null

if [ $? -eq 0 ]; then
  log "backup completed successfully"
  log "Backup saved to $BACKUP_DIR/system_backup.tar.gz"

  #calculate backupsize
  SIZE=$(du -sh "$BACKUP_DIR/system_backup.tar.gz" | cut -f1)
  log "Backup size: $SIZE"

else
  log "Backup failed"
  exit 1
fi

#clean old backups

log "cleaning backups older than $RETENTION_DAYS days"
find /backup -type d -mtime +$RETENTION_DAYS -exec rm -rf {} \; 2>/dev/null

log "Backup process completed"




